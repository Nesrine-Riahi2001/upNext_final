{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
<table>
    <tr>
        <td>{{ form_label(form.prix_total, "Le prix total : ") }}</td>
        <td>{{ form_widget(form.prix_total) }}</td>
        <td>{{ form_errors(form.prix_total) }}</td>
    </tr>
    <tr>
        <td>{{ form_label(form.date_commande, "La date de commande : ") }}</td>
        <td>{{ form_widget(form.date_commande) }}</td>
        <td>{{ form_errors(form.date_commande) }}</td>
    </tr>
    <tr>
        <td>{{ form_label(form.status, "Le statut : ") }}</td>
        <td>{{ form_widget(form.status) }}</td>
        <td>{{ form_errors(form.status) }}</td>
    </tr>
</table>
<button class="btn">{{ button_label|default('Commander ces produits') }}</button>
{{ form_end(form) }}