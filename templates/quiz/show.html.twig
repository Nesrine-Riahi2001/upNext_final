{% extends 'base-back.html.twig'%}

{% block title %}Quiz{% endblock %}

{% block body %}
    <h1>Quiz</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ quiz.id }}</td>
            </tr>
            <tr>
                <th>TitreQuiz</th>
                <td>{{ quiz.titreQuiz | default('No title provided') }}</td>
            </tr>
            <tr>
                <th>Sujet</th>
                <td>{{ quiz.sujet | default('No subject provided') }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_quiz_index') }}">back to list</a>

    <a href="{{ path('app_quiz_edit', {'id': quiz.id}) }}">edit</a>

    {{ include('quiz/_delete_form.html.twig') }}
{% endblock %}