{% extends 'admin/baseAdmin1.html.twig' %}

{% block title %}Suivi des Réservations{% endblock %}

{% block css %}
<!-- Favicons -->
<link href="{{'assets/img/up-next logo png.png'}}" rel="icon">
<link rel="icon" type="image/x-icon" href="{{'assets/img/up-next logo png.png'}}">

<!-- Add this inside <head> -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
<link href="{{'admin/vendor/fontawesome-free/css/all.min.css'}}" rel="stylesheet" type="text/css">
<link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

 <!-- Main CSS File -->
<link rel="stylesheet" href="{{'admin/css/sb-admin-2.min.css'}}" >
<link rel="stylesheet" href="{{'admin/css/sb-admin-2.css'}}">
{% endblock %}

{% block bar %}{% endblock %}

{% block head %}
<!-- Content Wrapper -->
<div id="content-wrapper" class="d-flex flex-column">
    <!-- Main Content -->
    <div id="content">
        <!-- Topbar -->
        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow d-flex justify-content-between align-items-center">
            <!-- Back Button -->
            <button class="btn btn-secondary" onclick="window.location.href='{{ path('app_admin') }}'" style="padding: 0.375rem 0.75rem;">
                <i class="fas fa-arrow-left"></i> Back
            </button>
        </nav>
    </div>
</div>
{% endblock %}

{% block home %}
<div class="container-fluid">
   
    <style>
        /* Center the Table */
        .table-container {
            max-width: 1300px;  /* Adjust width as needed */
            margin: 20px auto; /* Center horizontally and add equal spacing */
            padding: 25px;
            background: white;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0.2, 0.2);
        }
        
        /* Ensures equal vertical spacing between containers */
        .table-container + .table-container {
            margin-top: 20px; /* Consistent spacing between stacked containers */
        }

        /* Table Styling */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            overflow: hidden;
        }

        /* Header Styling */
        th, td {
            padding: 10px; /* Reduce padding */
            text-align: center; /* Center text */
            border-right: 1px solid #ddd;
        }

        /* Remove Border on Last Column */
        th:last-child, td:last-child {
            border-right: none;
        }

        /* Table Header */
        thead {
            background-color: rgb(76, 127, 255);
            color: white;
            text-transform: uppercase;
        }

        /* Alternate Row Colors */
        tbody tr:nth-child(even) {
            background-color: rgb(225, 231, 243);
        }

        /* Hover Effect */
        tbody tr:hover {
            background-color: rgba(245, 247, 249, 0.44);
        }

        /* Section Titles */
        h2 {
            text-align: center;
            color: #333;
            border-bottom: 3px solid #007bff;
            display: inline-block;
            padding-bottom: 5px;
        }

        /* Adjust Action Icons */
        .action-icons a {
            font-size: 18px; /* Smaller icons */
            padding: 4px;
            text-decoration: none;
            color: #333;
        }

        .action-icons a:hover {
            color: rgb(83, 151, 223);
        }
    </style>

    {% block top %}
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div class="container-fluid" style="margin: 0 80px;">  
            <h1 class="h3 mb-1 text-gray-800">Liste des Événements</h1>
        </div>
    </div>
    {% endblock %}

    <div class="table-container">
        <h2 style="display: inline-block;">Événements</h2>

        <table class="table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Date de début</th>
                    <th>Date de fin</th>
                    <th>Lieu</th>
                    <th>Image</th>
                    <th>Status</th> <!-- Nouvelle colonne pour le statut -->
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td>{{ event.title }}</td>
                        
                        <td>{{ event.descrip ? event.descrip : 'Pas de description' }}</td>
                        <td>{{ event.startdate ? event.startdate|date('d/m/Y H:i') : 'Non définie' }}</td>
                        <td>{{ event.enddate ? event.enddate|date('d/m/Y H:i') : 'Non définie' }}</td>
                        <td>{{ event.location ? event.location : 'Non définie' }}</td>
                        <td>
                            {% if event.image %}
                                <img src="{{ asset('uploads/images/' ~ event.image) }}" alt="Image de {{ event.title }}" width="100">
                            {% else %}
                                <span>Aucune image</span>
                            {% endif %}
                        </td>
                        <td>{{ event.getStatusEvent() ? event.getStatusEvent() : 'Non défini' }}</td> 
                         <td>
                            <form action="{{ path('event_delete', {'id': event.id}) }}" method="post" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                <button type="submit" class="btn btn-danger">Supprimer</button>
                            </form>
                        </td>
                        <td>
                            <!-- Changer le statut -->
                            {% if event.statusEvent == 'pending' %}
                                <a href="{{ path('event_change_status', {'id': event.id, 'status': 'approved'}) }}" class="btn btn-success btn-sm">Approuver</a>
                                <a href="{{ path('event_change_status', {'id': event.id, 'status': 'rejected'}) }}" class="btn btn-danger btn-sm">Rejeter</a>
                            {% elseif event.statusEvent == 'approved' %}
                                <a href="{{ path('event_change_status', {'id': event.id, 'status': 'pending'}) }}" class="btn btn-warning btn-sm">Repasser en attente</a>
                                <a href="{{ path('event_change_status', {'id': event.id, 'status': 'rejected'}) }}" class="btn btn-danger btn-sm">Rejeter</a>
                            {% elseif event.statusEvent == 'rejected' %}
                                <a href="{{ path('event_change_status', {'id': event.id, 'status': 'pending'}) }}" class="btn btn-warning btn-sm">Repasser en attente</a>
                                <a href="{{ path('event_change_status', {'id': event.id, 'status': 'approved'}) }}" class="btn btn-success btn-sm">Approuver</a>
                            {% endif %}
                        </td>
                        
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center">Aucun événement trouvé</td> <!-- Mise à jour du colspan -->
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}

{% block body %}{% endblock %}
