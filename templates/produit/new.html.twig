            <h1 class="text-center mb-5" style="color: #27ae60; font-size: 2.5rem;">Ajouter un Nouveau Produit Artistique</h1>
            {{ include('produit/_form.html.twig') }}
            <div class="text-start mt-4"> <!-- Changement ici : text-start au lieu de text-center -->
