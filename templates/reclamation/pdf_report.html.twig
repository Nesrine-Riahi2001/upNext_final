<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rapport des Réclamations</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f9f9f9;
        }
        header {
            background-color: #4e73df;
            color: white;
            padding: 10px 20px;
            text-align: center;
        }
        h1 {
            font-size: 24px;
            margin: 10px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border: 1px solid #ddd;
        }
        th {
            background-color: #4e73df;
            color: white;
            font-size: 14px;
        }
        td {
            font-size: 12px;
            background-color: #f8f9fc;
        }
        tr:nth-child(even) td {
            background-color: #f1f1f1;
        }
        tr:hover td {
            background-color: #f0f8ff;
        }
        footer {
            text-align: center;
            padding: 15px;
            font-size: 12px;
            background-color: #4e73df;
            color: white;
            margin-top: 30px;
        }
        .container {
            width: 90%;
            margin: auto;
        }
    </style>
</head>
<body>

<header>
    <h1>Rapport des Réclamations</h1>
</header>

<div class="container">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Titre</th>
                <th>Email Client</th>
                <th>Date de Création</th>
                <th>Date de Résolution</th>
                <th>Type de Réclamation</th>
                <th>Description</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for rec in reclamations %}
                <tr>
                    <td>{{ rec.id }}</td>
                    <td>{{ rec.titre }}</td>
                    <td>{{ rec.mailClientRec }}</td>
                    <td>{{ rec.dateCreationRec | date('d/m/Y H:i') }}</td>
                    <td>{{ rec.dateResolutionRec ? rec.dateResolutionRec | date('d/m/Y H:i') : 'Non résolu' }}</td>
                    <td>{{ rec.typeRec }}</td>
                    <td>{{ rec.descriptionRec }}</td>
                    <td>{{ rec.statusRec }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<footer>
    <p>Generated by Mariem</p>
</footer>

</body>
</html>
